	partition _DEBUG_Clientes_Com_Mais_De_Um_Vendedor = calculated
		mode: import
		source =
				
				VAR SupervisorAlvo = 307494
				VAR AnoMesFiltro = "202606"
				
				RETURN
				FILTER (
				    SUMMARIZE (
				        CALCULATETABLE (
