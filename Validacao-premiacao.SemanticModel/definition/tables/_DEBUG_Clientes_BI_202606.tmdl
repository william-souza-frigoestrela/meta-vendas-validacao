	partition _DEBUG_Clientes_BI_202606 = calculated
		mode: import
		source = ```
				
				VAR GerenteSel = "CARLOS EDUARDO BEGO"
				VAR AnoMesFiltro = "2026/06"
				
				-- 3 Supervisores oficiais do gerente em 202606
				VAR SupervisoresValidos = 
				    CALCULATETABLE (
				        VALUES ( DGEVQ_HIERARQUIAVENDANIVEL[SEQSUPERVISOR] ),
				        DGEVQ_HIERARQUIAVENDANIVEL[GERENTEVENDA] = GerenteSel,
				        DGEVQ_HIERARQUIAVENDANIVEL[MESANO] = AnoMesFiltro
				    )
				
				RETURN
				CALCULATETABLE (
				    SUMMARIZE (
				        DCVV_META_RVV_FERIAS2,
				        DCVV_META_RVV_FERIAS2[SEQCLIENTE],
				        DCVV_META_RVV_FERIAS2[SEQSUPERVISOR],
				        DCVV_META_RVV_FERIAS2[VENDEDOROFC],
				        DCVV_META_RVV_FERIAS2[CONTAGEM]
				    ),
				    DCVV_META_RVV_FERIAS2[ANOMES] = AnoMesFiltro,
				    DCVV_META_RVV_FERIAS2[CONTAGEM] > 0,
				    TREATAS ( SupervisoresValidos, DCVV_META_RVV_FERIAS2[SEQSUPERVISOR] )
				)
				```

	annotation PBI_Id = 381ff90f8cf4465587374909e493a3a1

