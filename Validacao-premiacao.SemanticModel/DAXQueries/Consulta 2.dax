
EVALUATE
ROW(
    "Com RemoveFilters",
    CALCULATE(
        DISTINCTCOUNT(DCVV_META_RVV_FERIAS2[SEQCLIENTE]),
        DCVV_META_RVV_FERIAS2[CONTAGEM] > 0,
        DCVV_META_RVV_FERIAS2[VENDEDOROFC] = "114268",
        REMOVEFILTERS(DimMes)
    ),

    "Sem RemoveFilters",
    CALCULATE(
        DISTINCTCOUNT(DCVV_META_RVV_FERIAS2[SEQCLIENTE]),
        DCVV_META_RVV_FERIAS2[CONTAGEM] > 0,
        DCVV_META_RVV_FERIAS2[VENDEDOROFC] = "114268"
    )
)


EVALUATE
SUMMARIZE(
    FILTER(
        DCVV_META_RVV_FERIAS2,
        DCVV_META_RVV_FERIAS2[VENDEDOROFC] = "114268"
            && DCVV_META_RVV_FERIAS2[CONTAGEM] > 0
    ),
    DCVV_META_RVV_FERIAS2[SEQCLIENTE]
)


EVALUATE
FILTER(
    ADDCOLUMNS(
        VALUES(DCVV_META_RVV_FERIAS2[SEQCLIENTE]),
        "QtdVendedores",
        CALCULATE(
            DISTINCTCOUNT(DCVV_META_RVV_FERIAS2[VENDEDOROFC])
        )
    ),
    [QtdVendedores] > 1
)


EVALUATE
FILTER(
    ADDCOLUMNS(
        SUMMARIZE(
            DCVV_META_RVV_FERIAS2,
            DCVV_META_RVV_FERIAS2[SEQCLIENTE]
        ),
        "QtdVendedores",
            CALCULATE(
                DISTINCTCOUNT(
                    DCVV_META_RVV_FERIAS2[VENDEDOROFC]
                )
            )
    ),
    [QtdVendedores] > 1
)



EVALUATE
SUMMARIZE(
    FILTER(
        DCVV_META_VENDADEVOLUCAO,
        DCVV_META_VENDADEVOLUCAO[ANOMES] = "202605"
            && DCVV_META_VENDADEVOLUCAO[SEQVENDEDOR] = "114268"
    ),
    DCVV_META_VENDADEVOLUCAO[SEQCLIENTE]
)



EVALUATE
EXCEPT(
    SUMMARIZE(
        FILTER(
            DCVV_META_VENDADEVOLUCAO,
            DCVV_META_VENDADEVOLUCAO[ANOMES] = "202605" &&
            DCVV_META_VENDADEVOLUCAO[SEQVENDEDOR] = "114268"
        ),
        DCVV_META_VENDADEVOLUCAO[SEQCLIENTE]
    ),
    SUMMARIZE(
        FILTER(
            DCVV_META_RVV_FERIAS2,
            DCVV_META_RVV_FERIAS2[VENDEDOROFC] = "114268" &&
            DCVV_META_RVV_FERIAS2[CONTAGEM] > 0
        ),
        DCVV_META_RVV_FERIAS2[SEQCLIENTE]
    )
)


EVALUATE
SUMMARIZE(
    FILTER(
        DCVV_META_RVV_FERIAS2,
        DCVV_META_RVV_FERIAS2[VENDEDOROFC] = "114268"
            && DCVV_META_RVV_FERIAS2[CONTAGEM] > 0
    ),
    DCVV_META_RVV_FERIAS2[SEQCLIENTE]
)


EVALUATE
SUMMARIZE(
    FILTER(
        DCVV_META_VENDADEVOLUCAO,
        DCVV_META_VENDADEVOLUCAO[ANOMES] = "202605" &&
        DCVV_META_VENDADEVOLUCAO[SEQVENDEDOR] = "114268" &&
        (
            DCVV_META_VENDADEVOLUCAO[VLRVENDA] -
            DCVV_META_VENDADEVOLUCAO[VLRDEVOLUCAO]
        ) > 0
    ),
    DCVV_META_VENDADEVOLUCAO[SEQCLIENTE]
)




EVALUATE
ROW(
    "Recorrencia",
    CALCULATE(
        DISTINCTCOUNT(DCVV_META_RVV_FERIAS2[SEQCLIENTE]),
        DCVV_META_RVV_FERIAS2[CONTAGEM] > 0,
        DCVV_META_RVV_FERIAS2[VENDEDOROFC] = "114268",
        DCVV_META_RVV_FERIAS2[ANOMES] = 202605
    )
)



