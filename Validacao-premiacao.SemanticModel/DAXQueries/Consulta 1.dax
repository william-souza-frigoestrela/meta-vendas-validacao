

EVALUATE
SUMMARIZE(
    FILTER(
        DCVV_META_RVV_FERIAS2,
        DCVV_META_RVV_FERIAS2[VENDEDOROFC] = "114268"
            && DCVV_META_RVV_FERIAS2[CONTAGEM] > 0
    ),
    DCVV_META_RVV_FERIAS2[SEQCLIENTE]
)





EVALUATE
FILTER(
    SUMMARIZE(
        DCVV_META_RVV_FERIAS2,
        DCVV_META_RVV_FERIAS2[SEQCLIENTE],
        "QtdVendedores",
        DISTINCTCOUNT(DCVV_META_RVV_FERIAS2[VENDEDOROFC])
    ),
    [QtdVendedores] > 1
)



EVALUATE
FILTER(
    SUMMARIZE(
        DCVV_META_RVV_FERIAS2,
        DCVV_META_RVV_FERIAS2[SEQCLIENTE],
        "QtdVendedores",
        DISTINCTCOUNT(DCVV_META_RVV_FERIAS2[VENDEDOROFC])
    ),
    [QtdVendedores] > 1
        &&
    CALCULATE(
        COUNTROWS(DCVV_META_RVV_FERIAS2),
        DCVV_META_RVV_FERIAS2[VENDEDOROFC] = "114268"
    ) > 0
)


